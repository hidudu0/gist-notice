{
  "name": "gist-notice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "deploy": "wrangler deploy",
    "logs": "wrangler tail --format pretty",
    "check": "curl -s -X POST -H \"x-admin-token: $(grep '^ADMIN_TOKEN=' .dev.vars | cut -d= -f2-)\" https://gist-notice.dudu0.workers.dev/api/run; echo",
    "subs": "wrangler kv key list --binding GIST --remote | grep -o 'sub:' | wc -l",
    "state": "wrangler kv key get --binding GIST --remote lastNo"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  }
}
